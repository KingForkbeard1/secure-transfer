# Copy to .env if you want to change defaults. The app runs fine without any of this (it uses a local SQLite file).
PORT=3000
# Local fallback database file, used only when DATABASE_URL is not set
DB_FILE=./server/data/secrets.db
# Hosted MySQL (or a MySQL-compatible service). Example: mysql://user:password@host:3306/dbname
# Never commit the real value. On Render, set it in the service's Environment tab.
DATABASE_URL=
# Set to 1 if your MySQL provider requires an encrypted (TLS) connection, which most hosted services do
DATABASE_SSL=0
# Set to 1 behind a reverse proxy (Render, Fly.io, nginx) so rate limits see real IPs
TRUST_PROXY=0
